{
  "info": {
    "name": "Lab 3 — Catalog API",
    "description": "Перевірка API каталогу нерухомості: список, пошук, фільтри, сортування, пагінація, окреме оголошення, 404 та 422.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "slug",
      "value": "dilianka-dlia-pryvatnoho-budynku"
    }
  ],
  "item": [
    {
      "name": "1. Список оголошень",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/catalog",
          "host": ["{{base_url}}"],
          "path": ["api", "catalog"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Відповідь містить список і метадані пагінації', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data).to.be.an('array');",
              "  pm.expect(body.meta).to.be.an('object');",
              "  pm.expect(body.links).to.be.an('object');",
              "  pm.expect(body.meta).to.have.property('current_page');",
              "  pm.expect(body.meta).to.have.property('per_page');",
              "  pm.expect(body.meta).to.have.property('total');",
              "});",
              "pm.test('Елемент має основні поля', function () {",
              "  const body = pm.response.json();",
              "  if (body.data.length > 0) {",
              "    pm.expect(body.data[0]).to.have.property('slug');",
              "    pm.expect(body.data[0]).to.have.property('title');",
              "    pm.expect(body.data[0]).to.have.property('price');",
              "    pm.expect(body.data[0]).to.have.property('category');",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Пошук за словом «будинок»",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/catalog?q=будинок",
          "host": ["{{base_url}}"],
          "path": ["api", "catalog"],
          "query": [{"key": "q", "value": "будинок"}]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Повертається масив результатів', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
          ]
        }
      }]
    },
    {
      "name": "3. Фільтр за категорією",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/catalog?category=Земельні%20ділянки",
          "host": ["{{base_url}}"],
          "path": ["api", "catalog"],
          "query": [{"key": "category", "value": "Земельні ділянки"}]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Результат відповідає вибраній категорії', function () {",
            "  const body = pm.response.json();",
            "  body.data.forEach(function (item) { pm.expect(item.category).to.eql('Земельні ділянки'); });",
            "});"
          ]
        }
      }]
    },
    {
      "name": "4. Фільтр за операцією",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/catalog?operation=Продаж",
          "host": ["{{base_url}}"],
          "path": ["api", "catalog"],
          "query": [{"key": "operation", "value": "Продаж"}]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Усі результати мають операцію Продаж', function () {",
            "  pm.response.json().data.forEach(function (item) { pm.expect(item.operation).to.eql('Продаж'); });",
            "});"
          ]
        }
      }]
    },
    {
      "name": "5. Сортування за зростанням ціни",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/catalog?sort=price_asc",
          "host": ["{{base_url}}"],
          "path": ["api", "catalog"],
          "query": [{"key": "sort", "value": "price_asc"}]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Ціни відсортовані за зростанням', function () {",
            "  const data = pm.response.json().data;",
            "  for (let i = 1; i < data.length; i++) { pm.expect(Number(data[i].price)).to.be.at.least(Number(data[i - 1].price)); }",
            "});"
          ]
        }
      }]
    },
    {
      "name": "6. Пагінація — 12 записів",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/catalog?per_page=12&page=1",
          "host": ["{{base_url}}"],
          "path": ["api", "catalog"],
          "query": [
            {"key": "per_page", "value": "12"},
            {"key": "page", "value": "1"}
          ]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Розмір сторінки дорівнює 12', function () { pm.expect(pm.response.json().meta.per_page).to.eql(12); });"
          ]
        }
      }]
    },
    {
      "name": "7. Одне оголошення за slug",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/catalog/{{slug}}",
          "host": ["{{base_url}}"],
          "path": ["api", "catalog", "{{slug}}"]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Відповідь містить оголошення', function () {",
            "  const body = pm.response.json();",
            "  pm.expect(body.data).to.be.an('object');",
            "  pm.expect(body.data.slug).to.eql(pm.collectionVariables.get('slug'));",
            "  pm.expect(body.data).to.have.property('attributes');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "8. Оголошення не знайдено — 404",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/catalog/no-such-product",
          "host": ["{{base_url}}"],
          "path": ["api", "catalog", "no-such-product"]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 404', function () { pm.response.to.have.status(404); });",
            "pm.test('JSON містить повідомлення про помилку', function () { pm.expect(pm.response.json()).to.have.property('message'); });"
          ]
        }
      }]
    },
    {
      "name": "9. Некоректне сортування — 422",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/catalog?sort=wrong",
          "host": ["{{base_url}}"],
          "path": ["api", "catalog"],
          "query": [{"key": "sort", "value": "wrong"}]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 422', function () { pm.response.to.have.status(422); });",
            "pm.test('JSON містить помилки валідації', function () { pm.expect(pm.response.json().errors).to.have.property('sort'); });"
          ]
        }
      }]
    },
    {
      "name": "10. Некоректний per_page — 422",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/catalog?per_page=10000",
          "host": ["{{base_url}}"],
          "path": ["api", "catalog"],
          "query": [{"key": "per_page", "value": "10000"}]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 422', function () { pm.response.to.have.status(422); });",
            "pm.test('JSON містить помилки валідації', function () { pm.expect(pm.response.json().errors).to.have.property('per_page'); });"
          ]
        }
      }]
    },
    {
      "name": "11. Некоректна сторінка — 422",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/catalog?page=0",
          "host": ["{{base_url}}"],
          "path": ["api", "catalog"],
          "query": [{"key": "page", "value": "0"}]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 422', function () { pm.response.to.have.status(422); });",
            "pm.test('JSON містить помилки валідації', function () { pm.expect(pm.response.json().errors).to.have.property('page'); });"
          ]
        }
      }]
    }
  ]
}
